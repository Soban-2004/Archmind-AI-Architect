# Supabase: Project Settings -> Database -> Connection string -> URI
# (use the "Session pooler" or direct connection string; must be Postgres, not the REST URL)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Groq: console.groq.com -> API Keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (optional): the judge pass — a second, independent model that
# reviews the architect's proposed architecture for structural correctness
# before it's accepted (services/interview.py::_run_judge). Leave unset to
# skip the judge entirely; the architect's output is then used as-is.
# aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

CORS_ORIGINS=http://localhost:3000
