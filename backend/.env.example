# Supabase: Project Settings -> Database -> Connection string -> URI
# (use the "Session pooler" or direct connection string; must be Postgres, not the REST URL)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Groq: console.groq.com -> API Keys. The one hard requirement — every
# other provider below is optional and additive (see llm/factory.py's
# actual fallback chain, and each one's own comment there for why it's
# positioned where it is).
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter (optional, tried FIRST when set): `:free`-suffixed models
# have NO token-per-minute ceiling at all — just a request-rate limit.
# Confirmed genuinely free, no card. The free-model roster churns without
# notice (confirmed live) — if this default 404s/errors as unavailable,
# check GET https://openrouter.ai/api/v1/models against your own account
# for a current one.
# openrouter.ai -> Keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Mistral (optional, tried LAST): a real 1B tokens/month free, but only
# 1 request/second — a third safety net, not where most traffic should
# land. Confirmed genuinely free, no card (phone-verified account only).
# console.mistral.ai -> API Keys
MISTRAL_API_KEY=...
MISTRAL_MODEL=mistral-small-latest

# Cerebras (optional, NOT in the active chain right now — see
# llm/factory.py's own comment): serves the same gpt-oss-120b model at a
# real ~4x higher TPM than Groq's free tier, but its free trial now
# requires a verified payment method (confirmed live — a real 402 from
# this project's own account). Safe to set; just currently unused until
# that's resolved and it's added back into factory.py's provider list.
# cloud.cerebras.ai -> API Keys
CEREBRAS_API_KEY=csk-...
CEREBRAS_MODEL=gpt-oss-120b

# Gemini (optional): the judge pass — a second, independent model that
# reviews the architect's proposed architecture for structural correctness
# before it's accepted (services/interview.py::_run_judge). Leave unset to
# skip the judge entirely; the architect's output is then used as-is.
# aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Tavily (optional): web-search grounding for time-sensitive advisory
# questions ("what's the current pricing for X", "is Y still maintained")
# — see services/web_search.py, intent_router.py's needs_web_grounding.
# Leave unset to skip search entirely; those answers fall back to the
# model's own (ungrounded) knowledge, same as before this existed.
# app.tavily.com
TAVILY_API_KEY=

CORS_ORIGINS=http://localhost:3000
