PUBLIC_ORIGIN=https://140.245.234.125

POSTGRES_DB=archmind
POSTGRES_USER=archmind
# Generate with: openssl rand -hex 32
# Hex avoids URL-encoding problems in the PostgreSQL connection URL.
POSTGRES_PASSWORD=replace_with_a_long_random_hex_value

# At least one architect provider key is required.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_MAX_OUTPUT_TOKENS=1800

# Optional provider fallbacks and features.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=
